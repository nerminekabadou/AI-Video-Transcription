# Backend (main.py)
ASSEMBLYAI_API_KEY=your-assemblyai-api-key   # https://www.assemblyai.com/app/account
GROQ_API_KEY=your-groq-api-key               # https://console.groq.com/keys
GROQ_MODEL=llama-3.3-70b-versatile
MAX_UPLOAD_MB=200
FRONTEND_ORIGIN=http://localhost:3000
# Only if ffmpeg is not on your PATH, e.g. C:/ffmpeg/bin/ffmpeg.exe
FFMPEG_PATH=

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
